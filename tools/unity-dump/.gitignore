# Unity regenerates everything except Assets/Editor, Assets/Theme, Packages
# and ProjectSettings/ProjectVersion.txt.
/Library/
/Temp/
/Logs/
/UserSettings/
/obj/
/Assets/Cases/
/Assets/Cases.meta
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
/Packages/packages-lock.json
*.csproj
*.sln
/Assets/GoldenCases/
/Assets/GoldenCases.meta
/Packages/com.uxml-preview.golden/
/Assets/Fixtures/
/Assets/Fixtures.meta
