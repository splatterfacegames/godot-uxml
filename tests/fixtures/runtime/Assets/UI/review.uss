.screen { flex-direction: column; width: 100%; height: 600px; }
.row300 { flex-direction: row; width: 300px; }
.w200 { width: 200px; height: 10px; }
.rowmax { flex-direction: row; height: 100px; }
.maxh { width: 20px; max-height: 30px; }
.colmax { flex-direction: column; width: 100px; }
.maxw { height: 10px; max-width: 40px; }
.fstyle:focus { border-top-width: 4px; }
.padded { padding-left: 12px; padding-top: 6px; }
.padlabel { padding-left: 12px; padding-top: 6px; }
.padimg { padding: 10px; }
.hoverfont { -unity-font-style: bold; }
.hoverfont:hover { color: #123456; }
.capfont:hover { color: #00ff00; font-size: 22px; }
.greened { color: green; }
.pctrow { flex-direction: row; width: 50%; }
.pctpad { padding-left: 10%; padding-top: 5%; }
.bgpad { padding-left: 10%; padding-top: 5%; background-image: url("icon.png"); }
.floorrow { flex-direction: row; width: 20px; }
.padfloor { width: 80px; padding-left: 12px; padding-right: 12px; border-left-width: 2px; border-right-width: 2px; }
.fonturl { -unity-font: url("font.ttf"); }
.fontbold { -unity-font-style: bold; }
.alignstate:hover { -unity-text-align: middle-right; white-space: nowrap; }
.smalldim { width: 4px; height: 4px; flex-shrink: 0; }
.missingbg { width: 10px; height: 10px; background-image: url("no-such.png"); }
