.screen { flex-grow: 1; padding: 8px; background-color: rgb(30, 32, 40); }
.tabs { flex-direction: row; }
.tab { width: 80px; height: 24px; }
.page { flex-grow: 1; border-width: 2px; border-color: rgb(90, 90, 120); border-radius: 4px; padding: 6px; }
.hidden { display: none; }
.row { flex-direction: row; height: 26px; margin-bottom: 2px; background-color: rgba(255, 255, 255, 0.05); }
.row:hover { background-color: rgba(255, 255, 255, 0.15); }
.row-label { width: 120px; color: rgb(220, 220, 230); font-size: 13px; }
.row-ctl { flex-grow: 1; }
.clip { overflow: hidden; height: 60px; border-width: 3px; border-color: red; }
.faded { opacity: 0.5; rotate: 5deg; translate: 4px 2px; }
.swatch { width: 20px; height: 20px; background-color: rgb(200, 80, 40); border-radius: 10px; }
